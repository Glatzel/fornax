{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonicalResults",
  "type": "object",
  "properties": {
    "meta": {
      "$ref": "#/$defs/RunMeta"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ComparisonResult"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta",
    "results"
  ],
  "$defs": {
    "ArtifactPaths": {
      "type": "object",
      "properties": {
        "error_map": {
          "type": "string"
        },
        "tile_summary": {
          "type": "string"
        }
      },
      "required": [
        "error_map",
        "tile_summary"
      ]
    },
    "ComparisonResult": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string"
        },
        "artifacts": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactPaths"
            },
            {
              "type": "null"
            }
          ]
        },
        "failed_limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FailedLimit"
          }
        },
        "kind": {
          "$ref": "#/$defs/ToleranceKind"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "metrics_interior": {
          "$ref": "#/$defs/Metrics"
        },
        "native": {
          "type": "boolean"
        },
        "pattern": {
          "type": "string"
        },
        "per_channel": {
          "$ref": "#/$defs/PerChannel"
        },
        "per_site": {
          "$ref": "#/$defs/PerSite"
        },
        "reference": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "total_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "worst_pixels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorstPixel"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "algorithm",
        "source_url",
        "pattern",
        "native",
        "reference",
        "kind",
        "verdict",
        "failed_limits",
        "total_samples",
        "metrics",
        "metrics_interior",
        "per_channel",
        "per_site",
        "worst_pixels"
      ]
    },
    "Conventions": {
      "type": "object",
      "properties": {
        "fornax": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "fornax",
        "reference"
      ]
    },
    "Coverage": {
      "type": "string",
      "enum": [
        "full",
        "partial"
      ]
    },
    "FailedLimit": {
      "type": "string",
      "enum": [
        "mae",
        "p99",
        "high_err_frac"
      ]
    },
    "Input": {
      "type": "object",
      "properties": {
        "black": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "black_height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "black_width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "type": "string"
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "native_pattern": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "white": {
          "type": "number",
          "format": "double"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "width",
        "height",
        "black",
        "black_width",
        "black_height",
        "white",
        "native_pattern"
      ]
    },
    "Limits": {
      "type": "object",
      "properties": {
        "high_err_frac": {
          "type": "number",
          "format": "double"
        },
        "high_err_threshold": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "mae": {
          "type": "number",
          "format": "double"
        },
        "p99": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "mae",
        "p99",
        "high_err_threshold",
        "high_err_frac"
      ]
    },
    "Metrics": {
      "type": "object",
      "properties": {
        "changed_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "changed_frac": {
          "type": "number",
          "format": "double"
        },
        "count_below_reference": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "count_gt1": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "count_gt1024": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "count_gt16": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "frac_gt1": {
          "type": "number",
          "format": "double"
        },
        "frac_gt1024": {
          "type": "number",
          "format": "double"
        },
        "frac_gt16": {
          "type": "number",
          "format": "double"
        },
        "mae": {
          "type": "number",
          "format": "double"
        },
        "max": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "mean_signed": {
          "type": "number",
          "format": "double"
        },
        "p99": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "p999": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "p9999": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "rmse": {
          "type": "number",
          "format": "double"
        },
        "total_samples": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "total_samples",
        "mae",
        "rmse",
        "max",
        "mean_signed",
        "p99",
        "p999",
        "p9999",
        "count_gt1",
        "frac_gt1",
        "count_gt16",
        "frac_gt16",
        "count_gt1024",
        "frac_gt1024",
        "count_below_reference",
        "changed_count",
        "changed_frac"
      ]
    },
    "PerChannel": {
      "type": "object",
      "properties": {
        "b": {
          "$ref": "#/$defs/Metrics"
        },
        "g": {
          "$ref": "#/$defs/Metrics"
        },
        "r": {
          "$ref": "#/$defs/Metrics"
        }
      },
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b"
      ]
    },
    "PerSite": {
      "type": "object",
      "properties": {
        "interpolated": {
          "$ref": "#/$defs/Metrics"
        },
        "sampled": {
          "$ref": "#/$defs/Metrics"
        }
      },
      "additionalProperties": false,
      "required": [
        "sampled",
        "interpolated"
      ]
    },
    "ReferenceBuild": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "commit"
      ]
    },
    "References": {
      "type": "object",
      "properties": {
        "darktable": {
          "$ref": "#/$defs/ReferenceBuild"
        },
        "libraw": {
          "$ref": "#/$defs/ReferenceBuild"
        }
      },
      "additionalProperties": false,
      "required": [
        "libraw",
        "darktable"
      ]
    },
    "RunMeta": {
      "type": "object",
      "properties": {
        "run": {
          "$ref": "#/$defs/RunMetadata"
        },
        "stable": {
          "$ref": "#/$defs/StableMeta"
        }
      },
      "additionalProperties": false,
      "required": [
        "stable",
        "run"
      ]
    },
    "RunMetadata": {
      "type": "object",
      "properties": {
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "generated_by": {
          "type": "string"
        },
        "shards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShardMetadata"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "coverage",
        "shards",
        "generated_by"
      ]
    },
    "Selection": {
      "type": "object",
      "properties": {
        "algorithms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "algorithms",
        "references",
        "patterns"
      ]
    },
    "ShardMetadata": {
      "type": "object",
      "properties": {
        "finished": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "runner": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "started": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "selection",
        "started",
        "finished",
        "runner"
      ]
    },
    "StableMeta": {
      "type": "object",
      "properties": {
        "border_px": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "conventions": {
          "$ref": "#/$defs/Conventions"
        },
        "dirty": {
          "type": "boolean"
        },
        "fornax_commit": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/Input"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "references": {
          "$ref": "#/$defs/References"
        }
      },
      "additionalProperties": false,
      "required": [
        "fornax_commit",
        "dirty",
        "references",
        "input",
        "border_px",
        "limits",
        "conventions"
      ]
    },
    "ToleranceKind": {
      "type": "string",
      "enum": [
        "exact",
        "rounding",
        "max_error",
        "robust"
      ]
    },
    "Verdict": {
      "type": "string",
      "enum": [
        "exact",
        "rounding_only",
        "pass_with_outliers",
        "pass",
        "fail"
      ]
    },
    "WorstPixel": {
      "type": "object",
      "properties": {
        "c": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "fornax": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "reference": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "x": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "c",
        "fornax",
        "reference"
      ]
    }
  }
}
