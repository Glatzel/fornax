{
  "terminal": {
    "env": {
      "PYTHONPATH": "${PYTHONPATH};./crates/fornax-py"
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "features": "all"
        },
        "cargo": {
          "features": "all",
          "extraEnv": {
            "CONDA_PREFIX": "./.pixi/envs/python"
          }
        },
        "runnables": {
          "extraEnv": {
            "CONDA_PREFIX": "./.pixi/envs/python"
          }
        },
        "server": {
          "extraEnv": {
            "CONDA_PREFIX": "./.pixi/envs/python"
          }
        }
      }
    }
  }
}
